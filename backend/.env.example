DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
FRONTEND_ORIGINS=
# Production A-share preference. US uses Yahoo -> Wind; HK uses Yahoo only in code.
MARKET_DATA_PROVIDER_ORDER=wind,baostock
# Used by Daily Summary only when there is no tracked market; CN, HK, US, or CRYPTO.
DAILY_SUMMARY_DEFAULT_MARKET=CN
WIND_MCP_URL=https://mcp.wind.com.cn/vserver_wind_tools/mcp/
WIND_MCP_BEARER_TOKEN=
TAVILY_MCP_ENABLED=true
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# Optional; when absent, Tavily MCP uses free, rate-limited keyless Search access.
TAVILY_API_KEY=
MGLLM_API_KEY=
# Optional absolute path when the SuperMind skill runner is installed elsewhere.
SUPERMIND_RUNNER_PATH=
# Keep this fixed so sync-files and execute-temp use the same remote directory.
SUPERMIND_JUPYTER_WORKDIR=mcp/tradingnote-backtests
# Standalone US backtest worker (bind the worker to localhost for local use).
US_BACKTEST_WORKER_URL=http://127.0.0.1:8001
# Required when deploying the worker behind HTTPS; set the same value on both processes.
US_BACKTEST_WORKER_TOKEN=
